{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mqtt": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 1883,
    "TopicFilter": "f1/canonical/#",
    "SubscriberClientId": "f1-race-state-service",
    "KeepAliveSeconds": 30
  },
  "StatePersistence": {
    "Enabled": true,
    "AutoRestoreOnStartup": true,
    "StorageDirectory": "./runtime-data",
    "SnapshotFileName": "current-race-state.json"
  }
}
