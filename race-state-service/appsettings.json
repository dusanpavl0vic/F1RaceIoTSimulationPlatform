{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000"
    ]
  },
  "Mqtt": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 1883,
    "TopicFilter": "f1/canonical/#",
    "SubscriberClientId": "f1-race-state-service",
    "KeepAliveSeconds": 30
  },
  "StatePersistence": {
    "Enabled": true,
    "AutoRestoreOnStartup": true,
    "StorageDirectory": "./runtime-data",
    "CheckpointFileName": "current-race-state.checkpoint.json"
  },
  "TelemetryAnalyticsGrpc": {
    "Endpoint": "http://localhost:8084"
  }
}
