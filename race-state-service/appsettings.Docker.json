{
  "Mqtt": {
    "Enabled": true,
    "Host": "mosquitto",
    "Port": 1883,
    "TopicFilter": "f1/canonical/#",
    "SubscriberClientId": "f1-race-state-service",
    "KeepAliveSeconds": 30
  },
  "StatePersistence": {
    "Enabled": true,
    "AutoRestoreOnStartup": true,
    "StorageDirectory": "/data",
    "CheckpointFileName": "current-race-state.checkpoint.json",
    "CurrentStateFileName": "current-race-state.json"
  }
}
