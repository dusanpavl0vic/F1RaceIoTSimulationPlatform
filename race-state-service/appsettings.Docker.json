{
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000"
    ]
  },
  "Mqtt": {
    "Enabled": true,
    "Host": "mosquitto",
    "Port": 1883,
    "TopicFilter": "f1/canonical/#",
    "SubscriberClientId": "f1-race-state-service",
    "KeepAliveSeconds": 30
  },
  "StatePersistence": {
    "Enabled": true,
    "AutoRestoreOnStartup": false,
    "ClearFilesOnStartup": true,
    "ClearFilesOnShutdown": true,
    "StorageDirectory": "/data",
    "CheckpointFileName": "current-race-state.checkpoint.json"
  },
  "TelemetryAnalyticsGrpc": {
    "Endpoint": "http://telemetry-analytics-service:8081"
  }
}
