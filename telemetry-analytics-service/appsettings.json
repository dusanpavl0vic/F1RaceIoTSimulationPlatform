{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mqtt": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 1883,
    "TopicFilter": "f1/canonical/#",
    "SubscriberClientId": "f1-telemetry-analytics-service",
    "KeepAliveSeconds": 30
  },
  "Postgres": {
    "ConnectionString": "Host=localhost;Port=5432;Database=f1_telemetry;Username=f1;Password=f1_password"
  },
  "InfluxDb": {
    "Enabled": true,
    "BaseUrl": "http://localhost:8086",
    "Organization": "f1-platform",
    "Bucket": "f1-telemetry",
    "Token": "f1-super-token",
    "WritePrecision": "ns"
  },
  "Analytics": {
    "StoreRawPayloads": true,
    "LapCompareBucketCount": 20,
    "SegmentBucketCount": 10
  }
}
