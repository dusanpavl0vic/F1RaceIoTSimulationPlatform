{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mqtt": {
    "Host": "localhost",
    "Port": 1883,
    "InputTopicFilter": "f1/raw/#",
    "OutputTopicPrefix": "f1/canonical",
    "SubscriberClientId": "f1-event-normalizer-sub",
    "PublisherClientId": "f1-event-normalizer-pub",
    "KeepAliveSeconds": 30,
    "LogPayloads": true
  }
}
