{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000"
    ]
  },
  "Replay": {
    "DefaultConfigurationPath": "./runtime-data/replay-config.generated.json",
    "StartFromSessionStatusStarted": true,
    "SessionStartLeadInSeconds": 0,
    "InitialFeedWindowSeconds": 120,
    "InitialWindowFeedNames": [
      "SessionInfo",
      "SessionStatus",
      "TrackStatus",
      "LapCount",
      "DriverList",
      "TimingData",
      "TimingStats",
      "TimingAppData",
      "LapSeries",
      "CurrentTyres",
      "TyreStintSeries",
      "RaceControlMessages"
    ],
    "ExcludedFeeds": [
      "WeatherData",
      "ChampionshipPrediction",
      "ContentStreams",
      "ExtrapolatedClock",
      "Heartbeat",
      "TeamRadio",
      "WeatherDataSeries"
    ]
  },
  "ReplayBootstrap": {
    "Enabled": false,
    "DownloadOnStartup": false,
    "AutoLoadOnStartup": false,
    "AutoStartOnStartup": false,
    "OverwriteExistingFiles": false,
    "IndexUrl": "https://livetiming.formula1.com/static/2021/2021-09-12_Italian_Grand_Prix/2021-09-12_Race/Index.json",
    "StorageRootPath": "./runtime-data",
    "GeneratedReplayConfigurationFileName": "replay-config.generated.json",
    "IndexFileName": "Index.json",
    "SessionId": "",
    "ReplaySpeed": 1.0,
    "StartOffsetMs": 0,
    "RequestTimeoutSeconds": 30,
    "MaxRetryAttempts": 10,
    "RetryDelaySeconds": 3
  },
  "Mqtt": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 1883,
    "ClientId": "f1-feed-replay-service",
    "Username": "",
    "Password": "",
    "KeepAliveSeconds": 30,
    "LogPayloads": false
  }
}
